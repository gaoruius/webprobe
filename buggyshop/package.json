{
  "name": "buggyshop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:clean": "NEXT_PUBLIC_BUGS=none next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "dev:clean-side": "NEXT_PUBLIC_BUGS=none NEXT_DIST_DIR=.next-clean next dev -p 3002",
    "test:regression": "playwright test",
    "test:regression:buggy": "NEXT_PUBLIC_BUGS=all playwright test",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:visual:update": "playwright test -c playwright.visual.config.ts --update-snapshots"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
